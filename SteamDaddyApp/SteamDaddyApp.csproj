<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>SteamDaddy</AssemblyName>
    <RootNamespace>SteamDaddy</RootNamespace>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>false</SelfContained>
    <UseAppHost>true</UseAppHost>
    <Win32ResourceFile>SteamDaddyApp.rc</Win32ResourceFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\install_b.ps1" Link="install_b.ps1" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
